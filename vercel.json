{
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "www",
  "functions": {
    "api/cierre-pdf.js": {
      "includeFiles": "{img/logo-factura.png,js/combos.js,node_modules/pdfkit/js/data/**}"
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/sales-monitor",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/daily-restock",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cierre-pdf",
      "schedule": "15 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/pedido.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
